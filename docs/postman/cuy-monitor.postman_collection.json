              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"answers 204\", () => pm.response.to.have.status(204));",
                      "pm.test(\"sets the access cookie\", () => pm.expect(pm.cookies.has(\"access_token\")).to.be.true);"
                    ]
