                "url": "{{baseUrl}}/api/v1/ingestion/events",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"type\": \"BEHAVIOR\",\n  \"cageId\": \"{{newCageId}}\",\n  \"timestamp\": \"{{now}}\",\n  \"source\": \"postman\",\n  \"schemaVersion\": 1,\n  \"payload\": {\n    \"color\": \"RED\",\n    \"windowSeconds\": 60,\n    \"stillSeconds\": 20,\n    \"feederVisits\": 2,\n    \"watererVisits\": 1,\n    \"avgGroupDistance\": 0.3,\n    \"probAnomaly\": 0.1,\n    \"detectionConfidence\": 0.92\n  }\n}"
                }
