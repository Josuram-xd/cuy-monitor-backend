        {
          "name": "Ingesta (X-API-Key)",
          "item": [
            {
              "name": "Lectura de peso",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/v1/ingestion/events",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"type\": \"WEIGHT\",\n  \"cageId\": \"{{newCageId}}\",\n  \"timestamp\": \"{{now}}\",\n  \"source\": \"postman\",\n  \"schemaVersion\": 1,\n  \"payload\": {\n    \"grams\": 1840.5,\n    \"stable\": true\n  }\n}"
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.variables.set(\"now\", new Date().toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"answers 202\", () => pm.response.to.have.status(202));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Ventana de comportamiento",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
