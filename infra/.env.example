# Copy to .env and fill in. NEVER commit the .env file.
# Generate secrets with:  openssl rand -hex 24

DOMAIN=your-subdomain.duckdns.org

# Amazon RDS for PostgreSQL (private, same VPC as the EC2).
# DB_HOST is the RDS endpoint. The password lives in AWS Secrets Manager:
#   aws secretsmanager get-secret-value --secret-id <MasterUserSecret ARN> --query SecretString --output text
DB_HOST=your-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cuymonitor
DB_USER=cuymonitor
DB_PASSWORD=change-me

# Shared by the ingestion endpoint and the AI service. Generate it, never reuse a real password.
API_KEY=change-me

# Also start the AI service (docker compose profile "ai").
COMPOSE_PROFILES=ai
# AI service: false = Amazon Bedrock analyses frames and audio, true = fake events.
AI_MOCK_MODE=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Secrets Manager secret that holds the RDS master password (it rotates every 7 days).
# infra/refresh-db-password.sh copies it into DB_PASSWORD; the EC2 role may read it.
DB_SECRET_ID=rds!db-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Signs the login tokens (HS256). At least 32 characters:  openssl rand -hex 32
APP_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Sign in with Google. Public client id of an OAuth "Web application" client (Google Cloud Console >
# APIs & Services > Credentials), with your https domain under "Authorized JavaScript origins".
# Not a secret. Leave empty to turn the Google button off. The dashboard build needs the same value.
GOOGLE_CLIENT_ID=

# OTP emails through Gmail SMTP. MAIL_PASSWORD is a Gmail "app password", not the account password
# (Google account > Security > 2-Step Verification > App passwords).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=change-me
MAIL_FROM=your-account@gmail.com
