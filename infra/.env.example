# Copy to .env and fill in. NEVER commit the .env file.
# Generate secrets with:  openssl rand -hex 24

DOMAIN=your-subdomain.duckdns.org

# Amazon RDS for PostgreSQL (private, same VPC as the EC2).
# DB_HOST is the RDS endpoint. The password lives in AWS Secrets Manager:
#   aws secretsmanager get-secret-value --secret-id <MasterUserSecret ARN> --query SecretString --output text
DB_HOST=your-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cuymonitor
DB_USER=cuymonitor
DB_PASSWORD=change-me

API_KEY=change-me

# Signs the login tokens (HS256). At least 32 characters:  openssl rand -hex 32
APP_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# OTP emails through Gmail SMTP. MAIL_PASSWORD is a Gmail "app password", not the account password
# (Google account > Security > 2-Step Verification > App passwords).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=change-me
MAIL_FROM=your-account@gmail.com
